                        "Fn::Sub": "#!/bin/bash\nset -x\nexec > /var/log/cloudlabs-bootstrap.log 2>&1\nmkdir -p /opt/paynotify/web\ncat > /opt/paynotify/web/index.html <<'EOF'\n<!DOCTYPE html>\n<html><head><title>PAYNOTIFY</title></head>\n<body style=\"font-family:Arial;background:#0b3d2e;color:#fff;text-align:center;padding-top:80px\">\n<h1>PAYNOTIFY Payment Notification Service</h1>\n<p>Web tier is online and serving traffic through the load balancer.</p>\n</body></html>\nEOF\necho OK > /opt/paynotify/web/health\ncat > /etc/systemd/system/paynotify-web.service <<'EOF'\n[Unit]\nDescription=PAYNOTIFY web front end\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1 --directory /opt/paynotify/web\nRestart=always\nUser=nobody\n\n[Install]\nWantedBy=multi-user.target\nEOF\nsystemctl daemon-reload\nsystemctl enable --now paynotify-web\nsystemctl enable amazon-ssm-agent\nsystemctl restart amazon-ssm-agent\n"
                    }
