{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "CloudLabs PAYNOTIFY AWS Troubleshooting Assessment - Windows jump VM, broken S3 bucket and broken Lambda function",
    "Parameters": {
        "CloudLabsDeploymentID": {
            "Type": "String"
        },
        "CheckAcknowledgement": {
            "Type": "String",
            "Default": "TRUE",
            "AllowedValues": [
                "TRUE",
                "FALSE"
            ]
        },
        "vpcCidr": {
            "Type": "String",
            "Default": "10.10.0.0/16"
        },
        "subnetCidr": {
            "Type": "String",
            "Default": "10.10.1.0/24",
            "Description": "Public subnet for the jump VM"
        },
        "AmazonECSTaskExecutionRolePolicy": {
            "Type": "String",
            "Default": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        },
        "VMUserName": {
            "Type": "String",
            "Default": "cloudadmin"
        },
        "VMPassword": {
            "Type": "String"
        }
    },
    "Resources": {
        "TaskExecutionRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": [
                                    "ecs-tasks.amazonaws.com"
                                ]
                            },
                            "Action": [
                                "sts:AssumeRole"
                            ]
                        }
                    ]
                },
                "Path": "/",
                "ManagedPolicyArns": [
                    {
                        "Ref": "AmazonECSTaskExecutionRolePolicy"
                    }
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "TaskExecutionRole-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "SSMRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "ec2.amazonaws.com"
                            },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
                ]
            }
        },
        "SSMInstanceProfile": {
            "Type": "AWS::IAM::InstanceProfile",
            "Properties": {
                "Roles": [
                    {
                        "Ref": "SSMRole"
                    }
                ]
            }
        },
        "clgVpc": {
            "Type": "AWS::EC2::VPC",
            "Properties": {
                "CidrBlock": {
                    "Ref": "vpcCidr"
                },
                "EnableDnsSupport": true,
                "EnableDnsHostnames": true,
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "clgVpc-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "clgInternetGateway": {
            "Type": "AWS::EC2::InternetGateway",
            "Properties": {
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "clgInternetGateway-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "attachInternetGateway": {
            "Type": "AWS::EC2::VPCGatewayAttachment",
            "Properties": {
                "InternetGatewayId": {
                    "Ref": "clgInternetGateway"
                },
                "VpcId": {
                    "Ref": "clgVpc"
                }
            }
        },
        "vmSubnet": {
            "Type": "AWS::EC2::Subnet",
            "Properties": {
                "AvailabilityZone": {
                    "Fn::Sub": "${AWS::Region}a"
                },
                "MapPublicIpOnLaunch": true,
                "VpcId": {
                    "Ref": "clgVpc"
                },
                "CidrBlock": {
                    "Ref": "subnetCidr"
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "vmSubnet-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "RouteTable": {
            "Type": "AWS::EC2::RouteTable",
            "Properties": {
                "VpcId": {
                    "Ref": "clgVpc"
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "RouteTable-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "routesToInternetGateway": {
            "Type": "AWS::EC2::Route",
            "DependsOn": "attachInternetGateway",
            "Properties": {
                "RouteTableId": {
                    "Ref": "RouteTable"
                },
                "DestinationCidrBlock": "0.0.0.0/0",
                "GatewayId": {
                    "Ref": "clgInternetGateway"
                }
            }
        },
        "vmSubnetRouteTableAssociation": {
            "Type": "AWS::EC2::SubnetRouteTableAssociation",
            "Properties": {
                "SubnetId": {
                    "Ref": "vmSubnet"
                },
                "RouteTableId": {
                    "Ref": "RouteTable"
                }
            }
        },
        "vmSecurityGroup": {
            "Type": "AWS::EC2::SecurityGroup",
            "Properties": {
                "GroupDescription": "Allow RDP to client host",
                "VpcId": {
                    "Ref": "clgVpc"
                },
                "SecurityGroupIngress": [
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 22,
                        "ToPort": 22,
                        "CidrIp": "0.0.0.0/0"
                    },
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 0,
                        "ToPort": 65535,
                        "CidrIp": "0.0.0.0/0"
                    },
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 80,
                        "ToPort": 80,
                        "CidrIp": "0.0.0.0/0"
                    }
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "vmSecurityGroup-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "clgSg": {
            "Type": "AWS::EC2::SecurityGroup",
            "Properties": {
                "GroupDescription": "Security group for Fargate ECS container - fully open",
                "VpcId": {
                    "Ref": "clgVpc"
                },
                "SecurityGroupIngress": [
                    {
                        "IpProtocol": "-1",
                        "CidrIp": "0.0.0.0/0"
                    },
                    {
                        "IpProtocol": "-1",
                        "CidrIpv6": "::/0"
                    }
                ],
                "SecurityGroupEgress": [
                    {
                        "IpProtocol": "-1",
                        "CidrIp": "0.0.0.0/0"
                    },
                    {
                        "IpProtocol": "-1",
                        "CidrIpv6": "::/0"
                    }
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "clgSg-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "vmInstance": {
            "Type": "AWS::EC2::Instance",
            "DependsOn": "routesToInternetGateway",
            "Properties": {
                "ImageId": {
                    "Fn::Sub": "{{resolve:ssm:/aws/service/ami-windows-latest/Windows_Server-2022-English-Full-Base}}"
                },
                "InstanceType": "t3.medium",
                "IamInstanceProfile": {
                    "Ref": "SSMInstanceProfile"
                },
                "SecurityGroupIds": [
                    {
                        "Ref": "vmSecurityGroup"
                    }
                ],
                "SubnetId": {
                    "Ref": "vmSubnet"
                },
                "BlockDeviceMappings": [
                    {
                        "DeviceName": "/dev/sda1",
                        "Ebs": {
                            "VolumeSize": 50,
                            "VolumeType": "gp3",
                            "DeleteOnTermination": true
                        }
                    }
                ],
                "UserData": {
                    "Fn::Base64": {
                        "Fn::Sub": "<powershell>\n$ErrorActionPreference = 'Continue'\nStart-Transcript -Path C:\\Windows\\Temp\\cloudlabs-bootstrap.log -Append\n$user = '${VMUserName}'\n$pass = @'\n${VMPassword}\n'@\n$pass = $pass.Trim()\n$sec = ConvertTo-SecureString $pass -AsPlainText -Force\nif (-not (Get-LocalUser -Name $user -ErrorAction SilentlyContinue)) {\n  New-LocalUser -Name $user -Password $sec -FullName 'CloudLabs Administrator' -PasswordNeverExpires -AccountNeverExpires\n} else {\n  Set-LocalUser -Name $user -Password $sec -PasswordNeverExpires $true\n}\nAdd-LocalGroupMember -Group 'Administrators' -Member $user -ErrorAction SilentlyContinue\nAdd-LocalGroupMember -Group 'Remote Desktop Users' -Member $user -ErrorAction SilentlyContinue\nSet-ItemProperty -Path 'HKLM:\\System\\CurrentControlSet\\Control\\Terminal Server' -Name 'fDenyTSConnections' -Value 0\nEnable-NetFirewallRule -DisplayGroup 'Remote Desktop'\n[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12\ntry {\n  Invoke-WebRequest -Uri 'https://awscli.amazonaws.com/AWSCLIV2.msi' -OutFile 'C:\\Windows\\Temp\\AWSCLIV2.msi' -UseBasicParsing\n  Start-Process msiexec.exe -ArgumentList '/i C:\\Windows\\Temp\\AWSCLIV2.msi /qn /norestart' -Wait\n} catch { Write-Output \"AWS CLI install failed: $_\" }\n$edge = 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe'\n$consoleUrl = 'https://${AWS::AccountId}.signin.aws.amazon.com/console?region=${AWS::Region}'\n$ws = New-Object -ComObject WScript.Shell\n$lnk = $ws.CreateShortcut('C:\\Users\\Public\\Desktop\\AWS Management Console.lnk')\nif (Test-Path $edge) { $lnk.TargetPath = $edge; $lnk.Arguments = $consoleUrl; $lnk.IconLocation = \"$edge,0\" } else { $lnk.TargetPath = $consoleUrl }\n$lnk.Save()\nSet-Service -Name AmazonSSMAgent -StartupType Automatic\nRestart-Service -Name AmazonSSMAgent -Force\nStop-Transcript\n</powershell>\n<persist>false</persist>"
                    }
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "labvm"
                    }
                ]
            }
        },
        "statementsBucket": {
            "Type": "AWS::S3::Bucket",
            "DeletionPolicy": "Delete",
            "UpdateReplacePolicy": "Delete",
            "Properties": {
                "BucketName": {
                    "Fn::Sub": "pn-statements-${CloudLabsDeploymentID}-${AWS::AccountId}"
                },
                "PublicAccessBlockConfiguration": {
                    "BlockPublicAcls": false,
                    "BlockPublicPolicy": false,
                    "IgnorePublicAcls": false,
                    "RestrictPublicBuckets": false
                },
                "OwnershipControls": {
                    "Rules": [
                        {
                            "ObjectOwnership": "BucketOwnerEnforced"
                        }
                    ]
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "pn-statements-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "statementsBucketPolicy": {
            "Type": "AWS::S3::BucketPolicy",
            "Properties": {
                "Bucket": {
                    "Ref": "statementsBucket"
                },
                "PolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Sid": "FreezeStatementUploads",
                            "Effect": "Deny",
                            "Principal": "*",
                            "Action": "s3:PutObject",
                            "Resource": {
                                "Fn::Sub": "arn:aws:s3:::${statementsBucket}/statements/*"
                            }
                        }
                    ]
                }
            }
        },
        "notifyLambdaRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": "lambda.amazonaws.com"
                            },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "pn-notify-role-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        },
        "notifyFunction": {
            "Type": "AWS::Lambda::Function",
            "Properties": {
                "FunctionName": {
                    "Fn::Sub": "pn-notify-${CloudLabsDeploymentID}"
                },
                "Runtime": "python3.12",
                "Handler": "index.handler",
                "Role": {
                    "Fn::GetAtt": [
                        "notifyLambdaRole",
                        "Arn"
                    ]
                },
                "Timeout": 15,
                "MemorySize": 128,
                "Environment": {
                    "Variables": {
                        "BUCKET_NAME": "pn-statements-archive"
                    }
                },
                "Code": {
                    "ZipFile": "import json\nimport os\nimport datetime\nimport boto3\n\ns3 = boto3.client('s3')\n\n\ndef lambda_handler(event, context):\n    bucket = os.environ['BUCKET_NAME']\n    customer = event.get('customer', 'demo-customer') if isinstance(event, dict) else 'demo-customer'\n    body = dict(service='PAYNOTIFY', status='notification-sent', customer=customer, time=datetime.datetime.utcnow().isoformat() + 'Z')\n    s3.put_object(Bucket=bucket, Key='notifications/latest.json', Body=json.dumps(body), ContentType='application/json')\n    print('Notification written to s3://' + bucket + '/notifications/latest.json')\n    return dict(statusCode=200, body=json.dumps(body))\n"
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "pn-notify-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
        }
    },
    "Outputs": {
        "CloudLabsDeploymentID": {
            "Description": "CloudLabs Deployment ID",
            "Value": {
                "Ref": "CloudLabsDeploymentID"
            }
        },
        "AWSAccountID": {
            "Description": "AWS Account ID",
            "Value": {
                "Ref": "AWS::AccountId"
            }
        },
        "Region": {
            "Description": "AWS Region",
            "Value": {
                "Ref": "AWS::Region"
            }
        },
        "VpcId": {
            "Description": "The ID of the VPC",
            "Value": {
                "Ref": "clgVpc"
            }
        },
        "vmSubnetId": {
            "Description": "The ID of the VM Subnet",
            "Value": {
                "Ref": "vmSubnet"
            }
        },
        "vmSecurityGroupId": {
            "Description": "The SG ID of the VM",
            "Value": {
                "Ref": "vmSecurityGroup"
            }
        },
        "clusterSecurityGroupId": {
            "Description": "The SG ID of the Cluster",
            "Value": {
                "Ref": "clgSg"
            }
        },
        "TaskExecutionRole": {
            "Description": "The ARN of the Role utilised by ECS Task Definition",
            "Value": {
                "Fn::GetAtt": [
                    "TaskExecutionRole",
                    "Arn"
                ]
            }
        },
        "InstanceId": {
            "Description": "EC2 Instance ID",
            "Value": {
                "Ref": "vmInstance"
            }
        },
        "VMName": {
            "Description": "Name of the VM",
            "Value": "labvm"
        },
        "VMPublicIP": {
            "Description": "VM Public IP",
            "Value": {
                "Fn::GetAtt": [
                    "vmInstance",
                    "PublicIp"
                ]
            }
        },
        "VMPrivateIP": {
            "Description": "VM Private IP",
            "Value": {
                "Fn::GetAtt": [
                    "vmInstance",
                    "PrivateIp"
                ]
            }
        },
        "VMPublicDNSName": {
            "Description": "Public DNS Name",
            "Value": {
                "Fn::GetAtt": [
                    "vmInstance",
                    "PublicDnsName"
                ]
            }
        },
        "VMPrivateDNSName": {
            "Description": "Private DNS Name",
            "Value": {
                "Fn::GetAtt": [
                    "vmInstance",
                    "PrivateDnsName"
                ]
            }
        },
        "VMUserName": {
            "Description": "VM Username",
            "Value": {
                "Ref": "VMUserName"
            }
        },
        "VMPassword": {
            "Description": "VM Password",
            "Value": {
                "Ref": "VMPassword"
            }
        },
        "StatementsBucket": {
            "Description": "PAYNOTIFY statements bucket",
            "Value": {
                "Ref": "statementsBucket"
            }
        },
        "LambdaFunctionName": {
            "Description": "PAYNOTIFY notification function",
            "Value": {
                "Ref": "notifyFunction"
            }
        }
    }
}
