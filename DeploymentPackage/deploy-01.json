                },
                "SecurityGroupIds": [
                    {
                        "Ref": "appSecurityGroup"
                    }
                ],
                "SubnetId": {
                    "Ref": "appSubnet"
                },
                "UserData": {
                    "Fn::Base64": {
                        "Fn::Sub": "#!/bin/bash\nset -x\nexec > /var/log/cloudlabs-bootstrap.log 2>&1\nmkdir -p /opt/paynotify\ncat > /opt/paynotify/healthcheck.sh <<'EOF'\n#!/bin/bash\n# PAYNOTIFY app tier health check\nBUCKET=\"${appDataBucket}\"\nDBHOST=\"${dbInstance.Endpoint.Address}\"\nREPORT=/tmp/paynotify-healthcheck.txt\nexport AWS_MAX_ATTEMPTS=2\nAWSC=\"aws --cli-connect-timeout 5 --cli-read-timeout 10\"\nTOKEN=$(curl -s -m 3 -X PUT http://169.254.169.254/latest/api/token -H \"X-aws-ec2-metadata-token-ttl-seconds: 300\")\nIID=$(curl -s -m 3 -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/instance-id)\nexport AWS_DEFAULT_REGION=$(curl -s -m 3 -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/placement/region)\n: > \"$REPORT\"\nres() { echo \"$1=$2\" >> \"$REPORT\"; printf '[%s] %-9s %s\\n' \"$2\" \"$1\" \"$3\"; }\nshort() { echo \"$1\" | grep -v '^$' | tail -n1 | cut -c1-170; }\necho \"PAYNOTIFY app tier health check on $IID\"\necho \"Bucket   : $BUCKET\"\necho \"Database : $DBHOST\"\necho \"------------------------------------------------------------\"\nCODE=$(curl -s -o /dev/null -m 8 -w \"%{http_code}\" https://checkip.amazonaws.com)\nif [ \"$CODE\" = \"200\" ]; then res INTERNET PASS \"Outbound HTTPS to the internet works\"; else res INTERNET FAIL \"No outbound internet access (result: $CODE)\"; fi\nif ERR=$($AWSC s3api list-objects-v2 --bucket \"$BUCKET\" --max-items 1 2>&1 >/dev/null); then res S3_LIST PASS \"Listed objects in the bucket\"; else res S3_LIST FAIL \"$(short \"$ERR\")\"; fi\necho \"probe from $IID at $(date -u +%FT%TZ)\" > /tmp/pn-probe.txt\nif ERR=$($AWSC s3 cp /tmp/pn-probe.txt \"s3://$BUCKET/probe/$IID.txt\" --only-show-errors 2>&1); then res S3_WRITE PASS \"Wrote probe/$IID.txt\"; else res S3_WRITE FAIL \"$(short \"$ERR\")\"; fi\nif ERR=$($AWSC s3 cp \"s3://$BUCKET/probe/$IID.txt\" /tmp/pn-probe-back.txt --only-show-errors 2>&1); then res S3_READ PASS \"Read probe/$IID.txt back\"; else res S3_READ FAIL \"$(short \"$ERR\")\"; fi\nif timeout 5 bash -c \"exec 3<>/dev/tcp/$DBHOST/3306\" 2>/dev/null; then res RDS_TCP PASS \"TCP 3306 to the database is open\"; else res RDS_TCP FAIL \"Cannot open TCP 3306 to $DBHOST\"; fi\necho \"INSTANCE=$IID\" >> \"$REPORT\"\necho \"CHECKED_AT=$(date -u +%FT%TZ)\" >> \"$REPORT\"\necho \"------------------------------------------------------------\"\nif ERR=$($AWSC s3 cp \"$REPORT\" \"s3://$BUCKET/reports/healthcheck-latest.txt\" --only-show-errors 2>&1); then\n  echo \"[PASS] Report uploaded to s3://$BUCKET/reports/healthcheck-latest.txt\"\nelse\n  echo \"[FAIL] Report upload failed: $(short \"$ERR\")\"\nfi\nEOF\nchmod 755 /opt/paynotify/healthcheck.sh\nsystemctl enable amazon-ssm-agent\nsystemctl restart amazon-ssm-agent\n"
                    }
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Sub": "pn-app-01-${CloudLabsDeploymentID}"
                        }
                    }
                ]
            }
